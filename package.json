{
  "name": "hivey-code",
  "displayName": "Hivey Code",
  "description": "%extension.description%",
  "version": "0.18.0",
  "publisher": "hivey",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlorianMartins/hivey-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "chat",
    "agent",
    "coding assistant",
    "code completion",
    "inline completion",
    "ollama",
    "local llm",
    "openrouter",
    "anthropic",
    "self-hosted",
    "offline",
    "privacy",
    "gdpr",
    "confidential",
    "ibm i",
    "as400",
    "rpgle",
    "sqlrpgle",
    "db2 for i",
    "arcad",
    "mcp"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hiveyCode",
          "title": "%container.title%",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "hiveyCodeSide",
          "title": "%container.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hiveyCode": [
        {
          "id": "hiveyCode.chat",
          "name": "%view.chat.name%",
          "type": "webview"
        }
      ],
      "hiveyCodeSide": [
        {
          "id": "hiveyCode.chatSide",
          "name": "%view.chat.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "hiveyCode.newSession",
        "title": "%command.newSession.title%",
        "category": "Hivey Code",
        "icon": "$(add)"
      },
      {
        "command": "hiveyCode.askAboutSelection",
        "title": "%command.askAboutSelection.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.showEgress",
        "title": "%command.showEgress.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.showCosts",
        "title": "%command.showCosts.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.toggleCompletions",
        "title": "%command.toggleCompletions.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.clearApiKey",
        "title": "%command.clearApiKey.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.indexWorkspace",
        "title": "%command.indexWorkspace.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.editSelection",
        "title": "%command.editSelection.title%",
        "category": "Hivey Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "hiveyCode.generateCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "Hivey Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "hiveyCode.explainTerminalSelection",
        "title": "%command.explainTerminalSelection.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.fixDiagnostic",
        "title": "%command.fixDiagnostic.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.explainDiagnostic",
        "title": "%command.explainDiagnostic.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.showHistory",
        "title": "%command.showHistory.title%",
        "category": "Hivey Code",
        "icon": "$(history)"
      },
      {
        "command": "hiveyCode.showModels",
        "title": "%command.showModels.title%",
        "category": "Hivey Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "hiveyCode.showPermissions",
        "title": "%command.showPermissions.title%",
        "category": "Hivey Code",
        "icon": "$(shield)"
      },
      {
        "command": "hiveyCode.pickCompletionModel",
        "title": "%command.pickCompletionModel.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.showMcp",
        "title": "%command.showMcp.title%",
        "category": "Hivey Code",
        "icon": "$(plug)"
      },
      {
        "command": "hiveyCode.restartMcp",
        "title": "%command.restartMcp.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.setArcadCredentials",
        "title": "%command.setArcadCredentials.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.clearArcadCredentials",
        "title": "%command.clearArcadCredentials.title%",
        "category": "Hivey Code"
      },
      {
        "command": "hiveyCode.exportSession",
        "title": "%command.exportSession.title%",
        "category": "Hivey Code",
        "icon": "$(save)"
      },
      {
        "command": "hiveyCode.pickModel",
        "title": "%command.pickModel.title%",
        "category": "Hivey Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "hiveyCode.setup",
        "title": "%command.setup.title%",
        "category": "Hivey Code",
        "icon": "$(plug)"
      },
      {
        "command": "hiveyCode.moveToSecondarySideBar",
        "title": "%command.moveToSecondarySideBar.title%",
        "category": "Hivey Code",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "hiveyCode.newSkill",
        "title": "%command.newSkill.title%",
        "category": "Hivey Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "hiveyCode.newAgent",
        "title": "%command.newAgent.title%",
        "category": "Hivey Code",
        "icon": "$(person-add)"
      },
      {
        "command": "hiveyCode.showDefinitions",
        "title": "%command.showDefinitions.title%",
        "category": "Hivey Code",
        "icon": "$(list-unordered)"
      },
      {
        "command": "hiveyCode.searchConversation",
        "title": "%command.searchConversation.title%",
        "category": "Hivey Code",
        "icon": "$(search)"
      },
      {
        "command": "hiveyCode.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Hivey Code",
        "icon": "$(gear)"
      },
      {
        "command": "hiveyCode.setLanguage",
        "title": "%command.setLanguage.title%",
        "category": "Hivey Code",
        "icon": "$(globe)"
      },
      {
        "command": "hiveyCode.newSpecialisedSession",
        "title": "%command.newSpecialisedSession.title%",
        "category": "Hivey Code",
        "icon": "$(list-selection)"
      },
      {
        "command": "hiveyCode.attachOpenEditors",
        "title": "%command.attachOpenEditors.title%",
        "category": "Hivey Code",
        "icon": "$(files)"
      },
      {
        "command": "hiveyCode.pinLastAnswer",
        "title": "%command.pinLastAnswer.title%",
        "category": "Hivey Code",
        "icon": "$(pin)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hiveyCode.searchConversation",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "navigation@0"
        },
        {
          "submenu": "hiveyCode.newConversation",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "navigation@1"
        },
        {
          "command": "hiveyCode.showHistory",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "navigation@2"
        },
        {
          "command": "hiveyCode.moveToSecondarySideBar",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_layout@1"
        },
        {
          "command": "hiveyCode.showEgress",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_more@0"
        },
        {
          "command": "hiveyCode.showCosts",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_more@1"
        },
        {
          "command": "hiveyCode.showPermissions",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_more@2"
        },
        {
          "command": "hiveyCode.showDefinitions",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_more@3"
        },
        {
          "command": "hiveyCode.showMcp",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_more@4"
        },
        {
          "command": "hiveyCode.setup",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "navigation@4"
        },
        {
          "command": "hiveyCode.exportSession",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_more@6"
        },
        {
          "command": "hiveyCode.openSettings",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_more@7"
        },
        {
          "command": "hiveyCode.setLanguage",
          "when": "view == hiveyCode.chat || view == hiveyCode.chatSide",
          "group": "9_more@8"
        }
      ],
      "editor/context": [
        {
          "command": "hiveyCode.askAboutSelection",
          "when": "editorHasSelection",
          "group": "hivey-code@1"
        },
        {
          "command": "hiveyCode.editSelection",
          "when": "editorTextFocus",
          "group": "hivey-code@2"
        }
      ],
      "scm/title": [
        {
          "command": "hiveyCode.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "terminal/context": [
        {
          "command": "hiveyCode.explainTerminalSelection",
          "group": "hivey-code@1"
        }
      ],
      "commandPalette": [
        {
          "command": "hiveyCode.fixDiagnostic",
          "when": "false"
        },
        {
          "command": "hiveyCode.explainDiagnostic",
          "when": "false"
        }
      ],
      "hiveyCode.newConversation": [
        {
          "command": "hiveyCode.newSession",
          "group": "1_new@0"
        },
        {
          "command": "hiveyCode.newSpecialisedSession",
          "group": "1_new@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hiveyCode.editSelection",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "hiveyCode.askAboutSelection",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      }
    ],
    "configuration": [
      {
        "title": "%config.section.general%",
        "order": 1,
        "properties": {
          "hiveyCode.language": {
            "type": "string",
            "enum": [
              "auto",
              "en",
              "fr"
            ],
            "default": "auto",
            "description": "%config.language%"
          },
          "hiveyCode.accounts": {
            "type": "null",
            "default": null,
            "markdownDescription": "%config.accounts%"
          },
          "hiveyCode.panel.minWidth": {
            "type": "number",
            "default": 260,
            "minimum": 0,
            "maximum": 600,
            "markdownDescription": "%config.panel.minWidth%"
          }
        }
      },
      {
        "title": "%config.section.model%",
        "order": 2,
        "properties": {
          "hiveyCode.chat.provider": {
            "type": "string",
            "enum": [
              "local",
              "openrouter",
              "openai-compatible",
              "anthropic"
            ],
            "default": "local",
            "markdownDescription": "%config.chat.provider%"
          },
          "hiveyCode.chat.model": {
            "type": "string",
            "default": "qwen2.5-coder:7b",
            "description": "%config.chat.model%"
          },
          "hiveyCode.endpoints.local": {
            "type": "string",
            "default": "http://127.0.0.1:11434/v1",
            "description": "%config.endpoints.local%"
          },
          "hiveyCode.endpoints.servers": {
            "type": "array",
            "default": [],
            "markdownDescription": "%config.endpoints.servers%",
            "items": {
              "type": "object",
              "required": [
                "name",
                "url"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "%config.endpoints.servers.name%"
                },
                "url": {
                  "type": "string",
                  "description": "%config.endpoints.servers.url%"
                }
              }
            }
          },
          "hiveyCode.endpoints.openaiCompatible": {
            "type": "string",
            "default": "",
            "description": "%config.endpoints.openaiCompatible%"
          },
          "hiveyCode.endpoints.openrouter": {
            "type": "string",
            "default": "https://openrouter.ai/api/v1",
            "description": "%config.endpoints.openrouter%"
          },
          "hiveyCode.endpoints.anthropic": {
            "type": "string",
            "default": "https://api.anthropic.com/v1",
            "description": "%config.endpoints.anthropic%"
          },
          "hiveyCode.escalation.policy": {
            "type": "string",
            "enum": [
              "never",
              "ask",
              "auto"
            ],
            "default": "ask",
            "markdownDescription": "%config.escalation.policy%"
          },
          "hiveyCode.escalation.provider": {
            "type": "string",
            "enum": [
              "openrouter",
              "openai-compatible",
              "anthropic"
            ],
            "default": "openrouter",
            "description": "%config.escalation.provider%"
          },
          "hiveyCode.escalation.model": {
            "type": "string",
            "default": "",
            "description": "%config.escalation.model%"
          }
        }
      },
      {
        "title": "%config.section.skills%",
        "order": 3,
        "properties": {
          "hiveyCode.skills.groups": {
            "type": "array",
            "default": [
              "general"
            ],
            "items": {
              "type": "string"
            },
            "markdownDescription": "%config.skills.groups%"
          },
          "hiveyCode.skills.disabled": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "markdownDescription": "%config.skills.disabled%"
          },
          "hiveyCode.agents.disabled": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "markdownDescription": "%config.agents.disabled%"
          },
          "hiveyCode.mcp.servers": {
            "type": "object",
            "default": {},
            "markdownDescription": "%config.mcp.servers%",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "stdio",
                    "http"
                  ],
                  "description": "stdio runs a program locally; http talks to a server."
                },
                "command": {
                  "type": "string",
                  "description": "The program to run (stdio)."
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "cwd": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "The server URL (http)."
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "disabled": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        }
      },
      {
        "title": "%config.section.privacy%",
        "order": 4,
        "properties": {
          "hiveyCode.privacy.redaction": {
            "type": "string",
            "enum": [
              "strict",
              "balanced",
              "off"
            ],
            "default": "strict",
            "markdownDescription": "%config.privacy.redaction%"
          },
          "hiveyCode.privacy.allowUnredacted": {
            "type": "boolean",
            "default": false,
            "description": "%config.privacy.allowUnredacted%"
          },
          "hiveyCode.privacy.blockedGlobs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/.env*",
              "**/*.pem",
              "**/*.key",
              "**/*.p12",
              "**/id_rsa*",
              "**/secrets/**",
              "**/credentials*",
              "**/.aws/**",
              "**/.ssh/**"
            ],
            "description": "%config.privacy.blockedGlobs%"
          },
          "hiveyCode.privacy.customTerms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.privacy.customTerms%"
          },
          "hiveyCode.privacy.egressPolicy": {
            "type": "string",
            "enum": [
              "ask-once",
              "ask-always",
              "trust"
            ],
            "default": "ask-once",
            "description": "%config.privacy.egressPolicy%"
          },
          "hiveyCode.privacy.confirmSend": {
            "type": "string",
            "enum": [
              "always",
              "never"
            ],
            "default": "always",
            "markdownDescription": "%config.privacy.confirmSend%"
          },
          "hiveyCode.privacy.auditLog": {
            "type": "boolean",
            "default": true,
            "description": "%config.privacy.auditLog%"
          },
          "hiveyCode.budget.perRequestUsd": {
            "type": "number",
            "default": 0.25,
            "description": "%config.budget.perRequestUsd%"
          },
          "hiveyCode.budget.dailyUsd": {
            "type": "number",
            "default": 2,
            "description": "%config.budget.dailyUsd%"
          }
        }
      },
      {
        "title": "%config.section.permissions%",
        "order": 5,
        "properties": {
          "hiveyCode.permissions.autoApprove": {
            "type": "string",
            "enum": [
              "off",
              "workspace",
              "all"
            ],
            "default": "off",
            "enumDescriptions": [
              "%config.permissions.autoApprove.off%",
              "%config.permissions.autoApprove.workspace%",
              "%config.permissions.autoApprove.all%"
            ],
            "markdownDescription": "%config.permissions.autoApprove%"
          },
          "hiveyCode.permissions.allowedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.permissions.allowedPaths%"
          },
          "hiveyCode.permissions.allowedCommands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.permissions.allowedCommands%"
          },
          "hiveyCode.permissions.deniedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.permissions.deniedPaths%"
          },
          "hiveyCode.permissions.deniedCommands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.permissions.deniedCommands%"
          }
        }
      },
      {
        "title": "%config.section.context%",
        "order": 6,
        "properties": {
          "hiveyCode.context.maxTokens": {
            "type": "number",
            "default": 8000,
            "description": "%config.context.maxTokens%"
          },
          "hiveyCode.context.repoMap": {
            "type": "boolean",
            "default": true,
            "description": "%config.context.repoMap%"
          }
        }
      },
      {
        "title": "%config.section.completion%",
        "order": 7,
        "properties": {
          "hiveyCode.completion.provider": {
            "type": "string",
            "enum": [
              "local",
              "openrouter",
              "openai-compatible",
              "off"
            ],
            "default": "local",
            "markdownDescription": "%config.completion.provider%"
          },
          "hiveyCode.completion.model": {
            "type": "string",
            "default": "qwen2.5-coder:7b",
            "description": "%config.completion.model%"
          },
          "hiveyCode.completion.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%config.completion.enabled%"
          },
          "hiveyCode.completion.debounceMs": {
            "type": "number",
            "default": 220,
            "description": "%config.completion.debounceMs%"
          },
          "hiveyCode.completion.maxTokens": {
            "type": "number",
            "default": 128,
            "description": "%config.completion.maxTokens%"
          },
          "hiveyCode.completion.multiline": {
            "type": "boolean",
            "default": true,
            "description": "%config.completion.multiline%"
          }
        }
      }
    ],
    "submenus": [
      {
        "id": "hiveyCode.newConversation",
        "label": "%submenu.newConversation.label%",
        "icon": "$(add)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs && node esbuild.mjs --tests && node --test dist-tests/",
    "package": "npx --yes @vscode/vsce@3 package --no-dependencies -o hivey-code.vsix",
    "models": "node scripts/update-models.mjs",
    "models:check": "node scripts/update-models.mjs --check",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --integration && node dist-integration/runTest.js",
    "publish:vsce": "npx --yes @vscode/vsce@3 publish --no-dependencies",
    "publish:ovsx": "npx --yes ovsx publish hivey-code.vsix",
    "vsix": "npm run build && npx --yes @vscode/vsce@3 package --no-dependencies -o hivey-code.vsix",
    "vsix:publish": "npm run vsix && gh release upload build hivey-code.vsix --clobber"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "hivey-code": "./dist/cli.js",
    "hivey": "./dist/cli.js"
  },
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "homepage": "https://github.com/FlorianMartins/hivey-vscode#readme",
